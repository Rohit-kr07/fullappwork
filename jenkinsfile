pipeline {
    agent any

    stages {
        stage('System Info') {
            steps {
                sh '''
                    echo "Current User:"
                    whoami

                    echo "Current Directory:"
                    pwd

                    echo "Files:"
                    ls -la
                '''
            }
        }

        stage('Docker Check') {
            steps {
                sh '''
                    docker --version || true
                '''
            }
        }

        stage('Done') {
            steps {
                echo 'Pipeline completed successfully!'
            }
        }
    }
}