pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Docker Compose Build') {
            steps {
                bat '''
                    docker compose build --no-cache
                '''
            }
        }

        stage('Docker Compose Up') {
            steps {
                bat '''
                    docker compose up -d
                '''
                
            }
        }
    }


    post {

    success {
        emailext(
            subject: "Docker Deployment Successful",
            body: """
            Login And Signup Application deployed successfully.

            Status: SUCCESS
            Project: Login And Signup Application
            """,
            to: "rk2986761@gmail.com"
        )

        echo 'Deployment Successful'
    }

    failure {
        emailext(
            attachLog: true,
            subject: "Docker Deployment Failed",
            body: """
            Login And Signup Application deployment failed.

            Status: FAILED

            Please check Jenkins console logs.
            """,
            to: "rk2986761@gmail.com"
        )

        echo 'Deployment Failed'
    }
}
}
    



